
@incollection{hallett_identity_2026,
	title = {Identity in the online linguistic landscape of {Midwestern} {Hispanic}-{Serving} {Institutions}},
	doi = {10.47788/AKXW6368},
	abstract = {Hispanic-Serving Institutions (HSIs) in the USA are not monolithic. Accordingly, their identities as places of HE vary greatly. This chapter examines the identities twenty-two HSIs in the American Midwest construct for themselves through their online linguistic landscapes (LL); that is, their websites. The specific focus of this chapter is an investigation of whether languages other than English (LOTEs) play a role in this identity construction vis-à-vis English. Despite their federally designated HSI status, Spanish at these public and private colleges and universities primarily serves an emblematic, a decorative, function (Matras 2009, Matras \& Robinson 2015) or a symbolic function (Bagna \& Bellinzona 2022) rather than any other communicative, informative, or interactive function in the digital world; that is, ‘the digital environments accessed via digital technology’ (Harris et al. 2022: 55). This study adds to the research on schoolscapes, the LL of educational settings (Brown 2012, Krompák et al. 2022, Menken et al. 2018, Szabó \& Troyer 2020, Vandenbroucke 2022, inter alia), expanding on the research findings of Hallett and Quiñones (2021), who found only emblematic uses of LOTEs in the public signage at an HSI in Chicago. These HSIs want to attract Hispanic students and maintain their federal HSI designation while concomitantly constructing a unique identity for the college or university. Our analysis reveals that the Spanish language in particular plays very different roles in the identity construction of these Midwestern HSIs.},
	booktitle = {Language and {Identity} in the {University}: {Exploring} {Marginality} and {Liminality} in {Higher} {Education}},
	publisher = {University of Exeter Press},
	author = {Hallett, Richard and Mullins, Brooke},
	editor = {Cerda, Yolanda and Winchester, Jules},
	year = {2026},
	pages = {129--143},
}
